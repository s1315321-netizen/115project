    characterSetSelectionMode: 7
    characterSequence: "\u3001\u3002\u300C\u300D\u3010\u3011\u4E00\u4E09\u4E0A\u4E0B\u4E0D\u4E14\u4E16\u4E26\u4E2D\u4E3B\u4E4B\u4E5F\u4E86\u4E88\u4E8B\u4E8C\u4E92\u4EA1\u4EAE\u4EC0\u4ECB\u4ED6\u4EE3\u4EE5\u4EF6\u4EFB\u4F4D\u4F4E\u4F4F\u4F55\u4F5C\u4F60\u4F75\u4F7F\u4F86\u4F8B\u4F9B\u4F9D\u4FDD\u4FEE\u500B\u5012\u503C\u504F\u505A\u505C\u5074\u5075\u5099\u50B3\u50CF\u5100\u512A\u5132\n\u5141\u5143\u5145\u5148\u5149\u514D\u5165\u5167\u5168\u5169\u5171\u5176\u5177\u518A\u518D\u51CD\u51FA\u5207\u5217\u521D\u5224\u5225\u5229\u5230\u5236\u523B\u5247\u524D\u525B\u5269\u529F\u52A0\u52D5\u52DD\u52F5\u52FE\u5305\u5316\u5319\u5340\u5354\u5361\u5373\u539F\u53BB\u53C3\u53C8\u53CD\u53D6\u53E3\u53E5\u53EA\u53EB\u53EF\u53F3\u540C\u540D\u5411\u5426\u5446\n\u547C\u547D\u54C1\u552F\u555F\u55AE\u5617\u5668\u56B4\u56DB\u56DE\u56E0\u570D\u5716\u5728\u5730\u57DF\u57F7\u5834\u586B\u58DE\u5916\u591A\u5927\u5931\u5957\u5973\u5982\u59CB\u5B50\u5B57\u5B58\u5B8C\u5B9A\u5BB6\u5BB9\u5BC6\u5BE6\u5BEB\u5BF8\u5C04\u5C07\u5C0B\u5C0D\u5C0F\u5C11\u5C31\u5C3A\u5C40\u5C4F\u5C64\u5DE6\u5DF1\u5DF2\u5E38\u5E40\u5E55\u5E73\u5E7E\u5E8F\n\u5E95\u5EA6\u5EA7\u5EFA\u5F0F\u5F35\u5F37\u5F48\u5F71\u5F85\u5F8C\u5F97\u5F9E\u5FA9\u5FAA\u5FC3\u5FC5\u6027\u602A\u6062\u606F\u6084\u609A\u60C5\u60F3\u611F\u614B\u6162\u6163\u61C9\u6210\u6216\u6232\u6236\u623F\u6240\u6247\u624B\u624D\u6253\u6263\u627E\u627F\u628A\u6293\u62AC\u62B5\u62BD\u62C9\u62D6\u62FE\u62FF\u6301\u6309\u6389\u6392\u639B\u63A5\u63A7\u63D0\u522A\u9664\u55CE\u958B\u59CB\r\n\u96E2\u958B\r\n\u8A2D\u5B9A\r\n\u97F3\u91CF\r\n\u4E3B\u9078\u55AE
      \r\n\u756B\u9762\u4EAE\u5EA6 \r\n\u8FD4\u56DE \r\n\u7E7C\u7E8C\u904A\u6232
      \r\n\u95DC\u9589 \r\n\u7269\u54C1\u6B04 \r\n\u9078\u55AE \r\n\u6210\u529F\u9003\u812B
      \r\n\u91CD\u65B0\u958B\u59CB \r\n\u96E2\u958B \r\n\u4F60\u6B7B\u4E86 \r\n\u91CD\u751F
      \r\n\u5728\u6FC3\u9727\u7030\u6F2B\u7684\u68EE\u6797\u6DF1\u8655\uFF0C\u4E00\u5834\u5065\u884C\u4E4B\u65C5\u6F14\u8B8A\u6210\u4E86\u60E1\u5922\u3002\u5728\u906E\u853D\u8996\u7DDA\u7684\u8FF7\u9727\u4E2D\uFF0C\u6211\u8207\u670B\u53CB\u8D70\u6563\u4E86\u2026\u2026
      \r\n\r\n\u53D7\u56F0\u65BC\u7121\u76E1\u6A39\u6797\u69CB\u6210\u7684\u8FF7\u5BAE\u4E2D\uFF0C\u6BCF\u4E00\u689D\u8DEF\u770B\u8D77\u4F86\u90FD\u4E00\u6A21\u4E00\u6A23\u3002\u6211\u8FF7\u5931\u4E86\u65B9\u5411\uFF0C\u5B64\u7ACB\u7121\u63F4\u3002
      \r\n\r\n\u96A8\u8457\u51B0\u51B7\u7684\u591C\u5E55\u964D\u81E8\uFF0C\u4E00\u5EA7\u7834\u6557\u7684\u5B85\u90B8\u5F9E\u6697\u5F71\u4E2D\u6D6E\u73FE\u3002\u7121\u8655\u53EF\u53BB\u7684\u6211\uFF0C\u53EA\u80FD\u8E0F\u5165\u5C4B\u5167\u5C0B\u6C42\u5E87\u8B77\u2026\u2026
      \r\n\r\n\u5728\u4FDD\u96AA\u7BB1\u88E1\u627E\u5230\u7684\u751F\u93FD\u820A\u9470\u5319\u3002\u53EF\u4EE5\u7528\u4F86\u6253\u958B102\u865F\u623F\u7684\u9580\u3002\r\n\r\n\u5728\u7BB1\u5B50\u88E1\u627E\u5230\u7684\u6C89\u91CD\u8001\u820A\u7684\u9435\u9470\u5319\u3002\u53EF\u4EE5\u7528\u4F86\u89E3\u958B\u5927\u9580\u7684\u9396\u9003\u96E2\u9019\u88E1\u3002 
      \r\n\r\n\u4E00\u6839\u9435\u88FD\u64AC\u68CD\u3002\u6216\u8A31\u53EF\u4EE5\u7528\u4F86\u64AC\u958B\u67D0\u4E9B\u6771\u897F\u3002
      \r\n\r\n\u624B\u96FB\u7B52\u7528\u7684\u65B0\u96FB\u6C60\u3002\u88DD\u5099\u624B\u96FB\u7B52\u6642\uFF0C\u6309\u4E0B
      [R] \u9375\u5373\u53EF\u66F4\u63DB\u96FB\u6C60\u3002 \r\n\r\n\u9700\u8981\u300C\u5927\u9580\u9470\u5319\u300D\u624D\u80FD\u9003\u51FA\u53BB\u3002
      \r\n\u9019\u662F\u6211\u525B\u624D\u722C\u9032\u4F86\u6642\u7528\u7684\u7A97\u6236\u3002
      \r\n\r\n\u7B49\u7B49\u2026\u2026\u7A97\u6236\u53BB\u54EA\u4E86\uFF1F\uFF01
      \r\n\r\n\u6D88\u5931\u4E86\u2026\u2026\u51FA\u53BB\u7684\u8DEF\u88AB\u5FB9\u5E95\u5C01\u6B7B\u4E86\uFF01
      \r\n\r\n\u6211\u88AB\u56F0\u5728\u9019\u88E1\u4E86\u2026\u2026 \r\n\r\n\u7121\u9650\u5236\r\n\u4FDD\u96AA\u7BB1\u5BC6\u78BC\u53EF\u80FD\u8207\u8D70\u5ECA\u7684\u756B\u4F5C\u6709\u95DC\u3002
      \r\n\r\n\u7D19\u689D\r\n\u4F7F\u7528/\u4E92\u52D5\r\n\r\n\u96FB\u6C60\u88DC\u5145\u4E86\r\n
      \u9700\u8981\r\n\r\n\u88AB\u9396\u4F4F\u4E86\u524D\u9762\u7684\u5340\u57DF\u4EE5\u5F8C\u518D\u4F86\u63A2\u7D22\u5427\u5B58\u6A94\r\n\u9078\u64C7\u8F38\u5165\u4FEE\u6539\u540D\u7A31\r\n\n\u63D2\u63DB\u63F4\u641C\u649E\u64AD\u64BF\u64CA\u64CB\u64CD\u64DA\u64EC\u652F\u6539\u653E\u6548\u6557\u6572\u6574\u6578\u6587\u6599\u65B0\u65B7\u65B9\u65BC\u65C1\u660E\u662F\u6642\u666F\u66A2\u66AB\u66F3\u66F4\u66FF\u6700\u6703\u6709\u671F\u672A\u672B\u672C\u675F\u677F\u679C\u67E5\u6838\u6839\u683C\u6846\u687F\u689D\u69FD\u6A02\u6A19\u6A21\u6A23\u6A5F\u6A94\u64C7\n\u6AA2\u6B04\u6B0A\u6B21\u6B62\u6B63\u6B64\u6B65\u6B78\u6B7B\u6BB5\u6BC0\u6BCF\u6BD4\u6C38\u6C60\u6C7A\u6C89\u6C92\u6CC1\u6CD5\u6D3B\u6D41\u6D88\u6DE1\u6DF1\u6E05\u6E21\u6E2C\u6E38\u6E90\u6E96\u6ED1\u6EFF\u6F14\u70BA\u7121\u7136\u715E\u7167\u71C8\u720D\u7236\u7247\u7248\u7269\u7279\u72C0\u734E\u7368\u7372\u7387\u73A9\u73BB\u73FE\u7406\u7483\u74B0\u751F\u7528\n\u7531\u754C\u7559\u756B\u7570\u7576\u767C\u767D\u7684\u76E3\u76E4\u76EE\u76F4\u76F8\u770B\u7784\u77AC\u77E5\u7834\u788E\u78B0\u78BA\u78BC\u793A\u7981\u79D2\u79FB\u7A0B\u7A31\u7A69\u7A7A\u7A81\u7A97\u7ACB\u7AD9\u7AEF\u7B2C\u7B49\u7B52\u7B97\u7BA1\u7BB1\u7BC4\u7C64\u7CFB\u7D05\u7D19\u7D30\u7D42\u7D44\u7D50\u7D66\u7D71\u7D81\u7D93\u7DA0\u7DAD\u7DDA\u7DE3\u7E2E\n\u7E3D\u7E7C\u7E8C\u7F3A\u7F6E\u7F8E\u7FFB\u8005\u8017\u8072\u807D\u80CC\u80FD\u812B\u8173\u81C9\u81EA\u81F3\u81F4\u8207\u822C\u8272\u82E5\u843D\u8457\u85CF\u8655\u865F\u87A2\u884C\u8853\u8868\u88AB\u88DC\u88DD\u88E1\u88FD\u8907\u8981\u8996\u89C0\u89D2\u89E3\u89F8\u8A00\u8A08\u8A0A\u8A18\u8A1D\u8A2D\u8A31\u8A3B\u8A66\u8A71\u8A72\u8A73\u8A8D\u8A9E\u8AA4\u8AAA\n\u8ABF\u8ACB\u8B0E\u8B1B\u8B80\u8B8A\u8B93\u8C61\u8CA0\u8CC7\u8D70\u8D77\u8DD1\u8DDD\u8DDF\u8DE8\u8DEF\u8DF3\u8E29\u8EAB\u8ECA\u8EF8\u8F09\u8F38\u8F49\u8FD1\u8FD4\u9001\u9003\u900F\u9010\u9014\u9019\u901A\u901D\u901F\u9020\u9023\u9032\u904A\u904E\u9053\u9054\u9060\u9078\u907A\u907F\u9084\u908A\u90A3\u90E8\u90FD\u914D\u91CD\u91CF\u9215\u92B7\u9304\u932F\u9375\n\u9396\u9470\u9580\u9583\u9589\u958B\u9593\u95DC\u9632\u963B\u9650\u9663\u9664\u968E\u9694\u96A8\u96AA\u96B1\u96D9\u96E2\u96F6\u96FB\u9700\u9707\u975C\u9760\u9762\u97F3\u97FF\u9802\u9806\u9808\u9810\u982D\u9846\u984C\u984D\u984F\u985E\u986F\u9918\u9996\u9A5A\u9A5F\u9AD4\u9AD8\u9B3C\u9EBC\u9EC3\u9ED1\u9EDE\u9F20\uFF01\uFF08\uFF09\uFF0C\uFF1A\uFF1B\uFF1F"
